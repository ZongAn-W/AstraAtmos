# AI 服务配置
# 请在此处填写你的 Google Gemini API Key 或其他兼容的 API Key
AI_API_KEY="your-api-key-here"

# 认证配置
# 生产环境下请修改此密钥以确保系统安全
JWT_SECRET_KEY=astraatmos-jwt-secret-change-in-production
DEFAULT_ADMIN_EMAIL=admin@astraatmos.com
DEFAULT_ADMIN_PASSWORD=admin123

# 邮件服务配置 (可选，用于发送系统通知)
SMTP_HOST="smtp.qq.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="AstraAtmos 行星大气实验室"

# 数据集注册表配置
# Earth uses only the three-hourly release; daily paths are archival configuration.
# ASTRAATMOS_EARTH_MERRA2_3HOURLY_DIR=data/earth/merra2_3hourly_v1
# ASTRAATMOS_EARTH_TRAINING_CACHE_DIR=../../../earth_training_cache
# Earth CUDA training: BF16 (when supported) or scaled FP16; CPU stays FP32.
# Set to 0 to disable autocast. TF32/cuDNN autotuning remain enabled on CUDA.
# ASTRAATMOS_EARTH_AMP=1
# Prefetch one CPU batch when the estimated extra data is at most 64 MiB.
# ASTRAATMOS_EARTH_PREFETCH=1
# Offline ETOPO atmospheric lower-boundary asset; optional for existing models.
# ASTRAATMOS_EARTH_TOPOGRAPHY_PATH=data/assets/earth_etopo2022_surface_0p75deg.nc
# Both development and production use the three-hourly Earth entry.
ASTRAATMOS_DEFAULT_EARTH_DATASET_ID=earth_merra2_3hourly_v1

# 训练环境配置
# 指定训练脚本执行时使用的 Python 解释器路径 (建议使用 Conda 虚拟环境)
TRAINING_PYTHON_PATH="C:\Path\To\Your\Environment\python.exe"

# Upload/revalidation model dry-run process budget (positive seconds).
USER_MODEL_VALIDATION_TIMEOUT_SECONDS=120
# Full-grid upload/revalidation, explicit probes and checkpoint reloads (positive seconds).
# Includes the independent 36x72 Earth contract; explicit call deadlines take priority.
# Task creation reuses the saved verdict and does not run these probes.
USER_MODEL_FULL_GRID_VALIDATION_TIMEOUT_SECONDS=900

# Optional independent Earth 5 degree (36x72) three-hour training release.
# ASTRAATMOS_EARTH_MERRA2_3HOURLY_5DEG_DIR=/external/data/earth/merra2_3hourly_5deg_v1
# ASTRAATMOS_EARTH_TOPOGRAPHY_5DEG_PATH=data/assets/earth_etopo2022_surface_5deg.nc
